# QuickLaunch AI Configuration
# Get your API key from: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=

# Default mode: "simple" or "agent"
DEFAULT_MODE=simple

# Model selection
SIMPLE_MODEL=gemini-2.5-flash
AGENT_MODEL=gemini-2.5-flash

# Global hotkey (e.g. "alt+space", "ctrl+shift+space")
LAUNCHER_HOTKEY=ctrl+space

# Enable Google Search grounding (Requires Gemini API billing enabled on Google AI Studio; leave false for free-tier keys)
SEARCH_ENABLED=false

# Sandboxed code execution timeout in seconds
SANDBOX_TIMEOUT=5.0
